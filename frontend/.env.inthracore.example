# Recommended:
# set only the InthraCore origin.
#
# Example:
# VITE_INTHRACORE_BASE_URL=https://YOUR-INTHRACORE-DOMAIN
#
# The frontend automatically resolves:
# /api/public/estrateji

VITE_INTHRACORE_BASE_URL=

# Optional explicit endpoint override.
# If supplied, this wins over VITE_INTHRACORE_BASE_URL.
VITE_INTHRACORE_NEWSROOM_URL=
